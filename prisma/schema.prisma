// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Equipment {
  id          String        @id @default(uuid())
  name        String        @unique
  description String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  reservations Reservation[]
}

model Period {
  id        String   @id @default(uuid())
  name      String   // Manhã, Tarde, Noite
  order     Int      // 1, 2, 3 para ordenação
  lessons   Lesson[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lesson {
  id          String   @id @default(uuid())
  periodId    String
  lessonNumber Int     // 1, 2, 3, 4, 5
  label       String   // Aula 1, Aula 2, etc.
  order       Int      // Para ordenação dentro do período
  period      Period   @relation(fields: [periodId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([periodId, lessonNumber])
}

model Reservation {
  id          String   @id @default(uuid())
  equipmentId String
  name        String
  phone       String?
  date        String
  periodId    String
  lessonNumber Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  
  @@unique([equipmentId, date, periodId, lessonNumber])
}
